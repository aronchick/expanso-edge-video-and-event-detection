# go2rtc laptop demo config TEMPLATE.
#
# IMPORTANT: Do not edit go2rtc.yaml directly — it is REGENERATED at every
# `just up` from this template by scripts/render-go2rtc-yaml.sh.
#
# go2rtc.yaml is REGENERATED at every `just up` from this template by
# scripts/render-go2rtc-yaml.sh, which picks the FIRST TWO AnkerWork C310
# cameras BY NAME (arbitrary order — the units are identical) and substitutes
# their current AVFoundation indices below. Resolution happens at render time,
# in the permitted parent context, because a go2rtc exec child cannot enumerate
# cameras: macOS gates `-list_devices` behind a camera permission the child
# never gets (it can still OPEN a device by index). render and the go2rtc
# launch are coupled, so the index is resolved seconds before capture — the
# macOS device-reorder window is tiny. If go2rtc is left running across a
# device reshuffle, re-run `just up` (re-render + relaunch) to refresh.
#
# Placeholders (substituted by scripts/render-go2rtc-yaml.sh):
#   __CAM_OUTSIDE_ARG__ → AVFoundation index for cam-outside (first Anker)
#   __CAM_INSIDE_ARG__  → AVFoundation index for cam-inside  (second Anker)
# The CAMERA_TEST / EDGE_CAM_* override modes substitute non-Anker indices here
# instead (Brio, built-in) for testing without the Ankers.
#
# Stream names MUST match data-stream="..." in public/edge/index.html:
#   - cam-outside  →  Sector North
#   - cam-inside   →  Sector South
#
# First run prompts macOS for Camera permission against whichever terminal
# launched `just up`. System Settings → Privacy & Security → Camera if you
# need to grant it manually.

api:
  listen: "127.0.0.1:1984"
  # Dashboard is served from http://localhost:8080 — different origin from
  # this WebRTC signaling endpoint at :1984, so the browser blocks the
  # cross-origin POST unless we send Access-Control-Allow-Origin. "*" is
  # safe here because the API is bound to 127.0.0.1 only (no LAN exposure.)
  origin: "*"

# RTSP listener — edge-sensor in real mode pulls
#   rtsp://localhost:8554/cam-outside
#   rtsp://localhost:8554/cam-inside
# go2rtc fans the same ffmpeg-spawned H.264 stream out to ALL consumers,
# so the dashboard's WebRTC and both edge-sensor RTSP pulls share one
# ffmpeg process per camera — no double-open of the webcam hardware.
rtsp:
  listen: "127.0.0.1:8554"

# Capture is a SINGLE external ffmpeg (scripts/dual-cam-capture.sh) that opens
# BOTH Ankers in one process and PUBLISHES each into the passive streams below
# via RTSP. One process = one device enumeration = the two feeds can never be
# the same camera. It downscales/caps each to a light 480p@15 stream.
streams:
  # PASSIVE RTSP-ingest streams. scripts/dual-cam-capture.sh runs a SINGLE
  # ffmpeg that opens BOTH AnkerWork cameras and PUBLISHES them here via RTSP
  # (rtsp://127.0.0.1:8554/cam-outside and /cam-inside). One process => one
  # enumeration => each physical camera gets exactly one index => the two feeds
  # can NEVER be the same camera. (The old per-stream `exec` model spawned two
  # separate ffmpeg processes that, with two identical-named C310s and macOS's
  # per-process index assignment, could collide on the same device.)
  cam-outside: []
  cam-inside: []

# Low log noise — go2rtc is chatty by default
log:
  level: warn
  api: warn
  exec: warn
  ngrok: warn
  rtsp: warn
  streams: warn
  webrtc: warn

.DS_Store
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.venv/
venv/
.env
.env.*
*.engine
*.onnx
models/
raw-events.ndjson
enriched-events.ndjson
state.json
commands.json
events/
recordings/
recording-catalog.ndjson
*.mp4
*.avi
*.mkv
test_frames/
node_modules/
config.yaml
.ruff_cache/
uv.lock
.credentials

# Detection model weights
*.pt
!requirements*.txt

# Dataset and training artifacts
dataset/
diagnostics/
runs/

# armyx-tech bootstrap secrets (AWS access keys)
.armyx-tech-secrets/
.gstack/

# Runtime SQLite stores + event logs (sensor + orchestrator)
*.db
*.db-journal
*.db-wal
*.db-shm

# Makefile demo state (PIDs + logs for `make up`/`make down`)
.demo-state/

# go2rtc binary (downloaded by `just install-go2rtc`)
bin/

# Generated go2rtc config — rendered fresh on each `just up` from
# go2rtc.yaml.template with whatever AVFoundation indices the Ankers
# happen to have at that moment.
go2rtc.yaml

# Annotated JPEGs that the real edge-sensor writes per-frame for the
# orchestrator's MJPEG /stream/{sector} fallback. Defaults to a CWD-
# relative "snapshots/" dir; transient state, never committed.
snapshots/
events.ndjson
detection-events.ndjson
triggers.yaml

# Internal demo material — verbal speaker scripts, deployment-specific
# bootstrap, runbooks, planning docs. Distributed out-of-band, not via git.
internal/

# Stray local recordings / large binaries that occasionally land at the root
jetson
*.mov
*.MOV

# nohup output from backgrounded demo processes
nohup.out

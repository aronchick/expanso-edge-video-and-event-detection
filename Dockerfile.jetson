FROM dustynv/l4t-pytorch:r35.4.1

# Install our dependencies
# Install deps — then remove pip's opencv (conflicts with base image's CUDA OpenCV)
RUN pip3 install --no-cache-dir \
    ultralytics \
    pydantic \
    pyyaml \
    fastapi \
    uvicorn \
    lapx \
    eval_type_backport \
    git+https://github.com/ultralytics/CLIP.git \
    && pip3 uninstall -y opencv-python opencv-python-headless 2>/dev/null; true

# Install our package
COPY . /app
WORKDIR /app
RUN pip3 install --no-cache-dir -e .

# Suppress YOLO noise
ENV YOLO_VERBOSE=false
ENV NO_COLOR=1

# Default command: run inference (stdout = JSON for Expanso)
CMD ["esc-infer", "config.yaml"]

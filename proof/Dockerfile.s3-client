# boto3 client for the S3 proof: creates the bucket and then checks, with the
# auditor's and the archive writer's keys, what the job wrote and what the
# service refuses.
FROM python:3.12-slim@sha256:02108f5d322dd89f1c9e552442c25acb0543dfdbc455693a5599624f20d9155d

RUN pip install --no-cache-dir boto3==1.40.35
